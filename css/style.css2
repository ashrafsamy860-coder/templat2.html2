root {
            --primary: #ff3e6c;
            --secondary: #1e293b;
            --accent: #f97316;
            --light: #f8fafc;
            --dark: #0f172a;
            --success: #22c55e;
            --gray: #94a3b8;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f1f5f9;
            color: var(--dark);
            line-height: 1.6;
            transition: var(--transition);
            position: relative;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* الخلفية المتحركة الرئيسية - الصورة الأولى */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(-45deg, #ff9a9e, #fad0c4, #fad0c4, #a1c4fd, #cfd9df, #e2ebf0, #ff6b6b, #4ecdc4, #45b7d1);
            background-size: 800% 800%;
            animation: gradientBG 25s ease infinite;
            z-index: -3;
            opacity: 0.15;
        }

        /* الخلفية المتحركة الثانية - الجسيمات */
        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 50%, rgba(255, 62, 108, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(249, 115, 22, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(34, 197, 94, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 60% 70%, rgba(168, 85, 247, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 30% 30%, rgba(251, 146, 60, 0.08) 0%, transparent 50%);
            animation: floatingBG 30s ease-in-out infinite;
            z-index: -2;
        }

        /* الخلفية المتحركة الثالثة - الخطوط الدوارة */
        .animated-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .animated-bg::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(255, 62, 108, 0.05) 50%,
                transparent 70%
            );
            animation: rotate 20s linear infinite;
        }

        .animated-bg::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                -45deg,
                transparent 30%,
                rgba(249, 115, 22, 0.05) 50%,
                transparent 70%
            );
            animation: rotate 15s linear infinite reverse;
        }

        /* جسيمات متحركة إضافية */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            background: var(--primary);
            border-radius: 50%;
            opacity: 0.15;
            animation: float 20s infinite ease-in-out;
        }

        .particle:nth-child(1) {
            width: 100px;
            height: 100px;
            left: 10%;
            animation-delay: 0s;
            animation-duration: 25s;
        }

        .particle:nth-child(2) {
            width: 80px;
            height: 80px;
            left: 30%;
            animation-delay: 3s;
            animation-duration: 22s;
            background: var(--accent);
        }

        .particle:nth-child(3) {
            width: 120px;
            height: 120px;
            left: 50%;
            animation-delay: 6s;
            animation-duration: 28s;
            background: var(--success);
        }

        .particle:nth-child(4) {
            width: 60px;
            height: 60px;
            left: 70%;
            animation-delay: 9s;
            animation-duration: 20s;
            background: var(--primary);
        }

        .particle:nth-child(5) {
            width: 90px;
            height: 90px;
            left: 90%;
            animation-delay: 12s;
            animation-duration: 24s;
            background: var(--accent);
        }

        .particle:nth-child(6) {
            width: 70px;
            height: 70px;
            left: 15%;
            animation-delay: 4s;
            animation-duration: 18s;
            background: #a855f7;
        }

        .particle:nth-child(7) {
            width: 110px;
            height: 110px;
            left: 85%;
            animation-delay: 8s;
            animation-duration: 26s;
            background: #3b82f6;
        }

        /* خلفية متحركة للبطاقات */
        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, 
                rgba(255, 255, 255, 0.1) 0%, 
                rgba(255, 255, 255, 0) 50%, 
                rgba(255, 255, 255, 0.1) 100%);
            transform: translateX(-100%);
            transition: transform 0.6s ease;
            z-index: 1;
        }

        .product-card:hover::before {
            transform: translateX(100%);
        }

        /* خلفية متحركة للأقسام */
        .section-bg {
            position: relative;
            overflow: hidden;
        }

        .section-bg::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 62, 108, 0.05) 0%, transparent 70%);
            animation: rotate 30s linear infinite;
            z-index: -1;
        }

        /* خلفية متحركة للسلايدر */
        .hero-slider::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, 
                rgba(255, 62, 108, 0.08) 0%, 
                rgba(249, 115, 22, 0.08) 50%, 
                rgba(34, 197, 94, 0.08) 100%);
            animation: shimmer 4s ease-in-out infinite;
            z-index: 1;
        }

        /* خلفية متحركة للتذييل */
        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 255, 255, 0.03) 50%, 
                transparent 100%);
            animation: shimmer 5s ease-in-out infinite;
            z-index: 1;
        }

        /* خلفية متحركة للقائمة الجانبية */
        .side-menu::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, 
                rgba(255, 62, 108, 0.05) 0%, 
                transparent 50%, 
                rgba(249, 115, 22, 0.05) 100%);
            z-index: -1;
        }

        /* الأنيميشنات */
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            25% { background-position: 100% 50%; }
            50% { background-position: 100% 100%; }
            75% { background-position: 0% 100%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes floatingBG {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            20% { transform: translate(-30px, -30px) rotate(1deg); }
            40% { transform: translate(30px, -20px) rotate(-1deg); }
            60% { transform: translate(-20px, 30px) rotate(1deg); }
            80% { transform: translate(20px, 20px) rotate(-1deg); }
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes float {
            0%, 100% { 
                transform: translateY(0) translateX(0) scale(1);
                opacity: 0.15;
            }
            25% { 
                transform: translateY(-150px) translateX(80px) scale(1.2);
                opacity: 0.25;
            }
            50% { 
                transform: translateY(-80px) translateX(-60px) scale(0.9);
                opacity: 0.2;
            }
            75% { 
                transform: translateY(-200px) translateX(40px) scale(1.1);
                opacity: 0.15;
            }
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideInUp {
            from { 
                opacity: 0;
                transform: translateY(30px);
            }
            to { 
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideInRight {
            from { 
                opacity: 0;
                transform: translateX(30px);
            }
            to { 
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes zoomIn {
            from { 
                opacity: 0;
                transform: scale(0.9);
            }
            to { 
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
            40% {transform: translateY(-10px);}
            60% {transform: translateY(-5px);}
        }

        body.menu-open {
            overflow: hidden;
        }

        /* التصميم العام */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        /* الشريط العلوي */
        .top-bar {
            background: linear-gradient(to right, var(--primary), var(--accent));
            color: white;
            padding: 8px 0;
            font-size: 14px;
            position: relative;
            overflow: hidden;
        }

        .top-bar::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 255, 255, 0.2) 50%, 
                transparent 100%);
            animation: shimmer 3s ease-in-out infinite;
        }

        .top-bar-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        /* شريط التنقل */
        .navbar {
            background-color: white;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
            background-color: rgba(255, 255, 255, 0.95);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
            position: relative;
        }

        .logo i {
            margin-right: 8px;
            animation: pulse 2s infinite;
        }

        /* الشرط الجانبية بجانب الرئيسية */
        .menu-bars {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 20px;
            height: 14px;
            margin-right: 10px;
            cursor: pointer;
            transition: var(--transition);
        }

        .menu-bars span {
            display: block;
            height: 2px;
            background: var(--primary);
            transition: var(--transition);
        }

        .menu-bars:hover span {
            background: var(--accent);
        }

        .search-bar {
            display: flex;
            flex: 1;
            max-width: 500px;
            margin: 0 20px;
        }

        .search-bar input {
            flex: 1;
            padding: 10px 15px;
            border: 2px solid var(--gray);
            border-radius: 4px 0 0 4px;
            outline: none;
            transition: var(--transition);
        }

        .search-bar input:focus {
            border-color: var(--primary);
        }

        .search-bar button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            transition: var(--transition);
        }

        .search-bar button:hover {
            background: var(--accent);
        }

        .nav-icons {
            display: flex;
            align-items: center;
        }

        .nav-icon {
            position: relative;
            margin-left: 20px;
            color: var(--dark);
            text-decoration: none;
            transition: var(--transition);
            font-size: 20px;
        }

        .nav-icon:hover {
            color: var(--primary);
            transform: translateY(-2px);
        }

        .facebook-icon:hover {
            color: #1877F2;
        }

        .instagram-icon:hover {
            color: #E4405F;
        }

        .menu-toggle {
            display: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--dark);
            transition: var(--transition);
        }

        .menu-toggle:hover {
            color: var(--primary);
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--primary);
            color: white;
            font-size: 12px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* القائمة */
        .categories {
            background: var(--secondary);
            padding: 12px 0;
            position: relative;
            overflow: hidden;
        }

        .categories::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 255, 255, 0.1) 50%, 
                transparent 100%);
            animation: shimmer 4s ease-in-out infinite;
        }

        .categories-list {
            display: flex;
            list-style: none;
            justify-content: space-between;
            position: relative;
            z-index: 1;
        }

        .categories-list li a {
            color: white;
            text-decoration: none;
            padding: 5px 10px;
            transition: var(--transition);
            border-radius: 4px;
        }

        .categories-list li a:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* القائمة الجانبية - المحسنة */
        .side-menu {
            position: fixed;
            top: 0;
            right: -300px;
            width: 300px;
            height: 100%;
            background: white;
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            transition: var(--transition);
            overflow-y: auto;
            padding: 20px;
        }

        .side-menu.open {
            right: 0;
        }

        .side-menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .side-menu-logo {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
        }

        .side-menu-logo i {
            margin-left: 8px;
        }

        .close-menu {
            font-size: 24px;
            cursor: pointer;
            color: var(--dark);
            transition: var(--transition);
            background: none;
            border: none;
        }

        .close-menu:hover {
            color: var(--primary);
            transform: rotate(90deg);
        }

        .side-menu-links {
            list-style: none;
            margin-bottom: 30px;
        }

        .side-menu-links li {
            margin-bottom: 15px;
        }

        .side-menu-links a {
            color: var(--dark);
            text-decoration: none;
            font-size: 18px;
            transition: var(--transition);
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f1f1;
        }

        .side-menu-links a i {
            margin-left: 10px;
            width: 20px;
            text-align: center;
        }

        .side-menu-links a:hover {
            color: var(--primary);
            padding-right: 10px;
        }

        .side-menu-category {
            margin-top: 20px;
        }

        .side-menu-category h3 {
            font-size: 16px;
            margin-bottom: 10px;
            color: var(--secondary);
            padding-bottom: 5px;
            border-bottom: 1px solid #eee;
        }

        .side-menu-category ul {
            list-style: none;
        }

        .side-menu-category li {
            margin-bottom: 8px;
        }

        .side-menu-category a {
            color: var(--dark);
            text-decoration: none;
            font-size: 16px;
            transition: var(--transition);
            display: block;
            padding: 5px 0;
        }

        .side-menu-category a:hover {
            color: var(--primary);
            padding-right: 5px;
        }

        .side-menu-social {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        .side-menu-social a {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin: 0 10px;
            color: white;
            font-size: 18px;
            transition: var(--transition);
        }

        .side-menu-facebook {
            background: #1877F2;
        }

        .side-menu-instagram {
            background: #E4405F;
        }

        .side-menu-social a:hover {
            transform: translateY(-3px);
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }

        .overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* السلايدر */
        .hero-slider {
            position: relative;
            height: 400px;
            overflow: hidden;
            margin: 20px 0;
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1s ease;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            padding: 0 50px;
        }

        .slide:target {
            opacity: 1;
        }

        .slide-content {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 8px;
            max-width: 500px;
            position: relative;
            z-index: 2;
        }

        .slide-content h2 {
            font-size: 32px;
            margin-bottom: 15px;
            color: var(--primary);
        }

        .slide-content p {
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            background: var(--primary);
            color: white;
            padding: 10px 20px;
            border-radius: 4px;
            text-decoration: none;
            transition: var(--transition);
            font-weight: 600;
        }

        .btn:hover {
            background: var(--accent);
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .slider-controls {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
        }

        .slider-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: var(--transition);
        }

        .slider-dot.active {
            background: white;
            transform: scale(1.2);
        }

        /* قسم المنتجات */
        .section-title {
            text-align: center;
            margin: 40px 0 20px;
            position: relative;
            padding-bottom: 15px;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: var(--primary);
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .product-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
        }

        .product-image {
            height: 200px;
            overflow: hidden;
            position: relative;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

        .product-card:hover .product-image img {
            transform: scale(1.1);
        }

        .product-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--primary);
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            z-index: 2;
        }

        .product-info {
            padding: 15px;
            position: relative;
            z-index: 2;
        }

        .product-title {
            font-size: 16px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .product-price {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .current-price {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary);
        }

        .original-price {
            text-decoration: line-through;
            color: var(--gray);
            margin-right: 10px;
        }

        .discount {
            color: var(--success);
            font-weight: 600;
            margin-right: 10px;
        }

        .product-actions {
            display: flex;
            justify-content: space-between;
        }

        .add-to-cart {
            flex: 1;
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 600;
        }

        .add-to-cart:hover {
            background: var(--accent);
        }

        .wishlist {
            width: 40px;
            margin-right: 10px;
            background: #f1f5f9;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition);
        }

        .wishlist:hover {
            background: var(--primary);
            color: white;
        }

        /* قسم العروض */
        .offers {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin: 30px 0;
        }

        .offer-card {
            position: relative;
            height: 200px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .offer-card:hover {
            transform: translateY(-5px);
        }

        .offer-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .offer-content {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.7), transparent);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 30px;
        }

        /* صفحات الحساب */
        .account-page {
            display: none;
            padding: 40px 0;
        }

        .account-page:target {
            display: block;
            animation: fadeIn 0.5s ease-in-out;
        }

        .account-form {
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 30px;
            max-width: 500px;
            margin: 0 auto;
            animation: slideInUp 0.5s ease-in-out;
        }

        .account-form h2 {
            text-align: center;
            margin-bottom: 25px;
            color: var(--primary);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--gray);
            border-radius: 4px;
            transition: var(--transition);
        }

        .form-group input:focus {
            border-color: var(--primary);
            outline: none;
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .remember-me {
            display: flex;
            align-items: center;
        }

        .remember-me input {
            margin-left: 8px;
        }

        .forgot-password {
            color: var(--primary);
            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .submit-btn {
            width: 100%;
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }

        .submit-btn:hover {
            background: var(--accent);
        }

        .account-switch {
            text-align: center;
            margin-top: 20px;
        }

        .account-switch a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .account-switch a:hover {
            text-decoration: underline;
        }

        /* صفحة تفاصيل المنتج */
        .product-detail-page {
            display: none;
            padding: 40px 0;
        }

        .product-detail-page:target {
            display: block;
            animation: fadeIn 0.5s ease-in-out;
        }

        .product-detail {
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 30px;
            animation: slideInUp 0.5s ease-in-out;
        }

        .product-detail-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .product-detail-image {
            border-radius: 8px;
            overflow: hidden;
            animation: zoomIn 0.5s ease-in-out;
        }

        .product-detail-image img {
            width: 100%;
            height: auto;
            display: block;
            transition: var(--transition);
        }

        .product-detail-image:hover img {
            transform: scale(1.05);
        }

        .product-detail-info {
            animation: slideInRight 0.5s ease-in-out;
        }

        .product-detail-info h1 {
            font-size: 28px;
            margin-bottom: 15px;
            color: var(--dark);
        }

        .product-detail-price {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .product-detail-price .current-price {
            font-size: 24px;
        }

        .product-detail-price .original-price {
            font-size: 18px;
        }

        .product-detail-description {
            margin-bottom: 25px;
            line-height: 1.8;
        }

        .product-options {
            margin-bottom: 25px;
        }

        .option-title {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .color-options, .size-options {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .color-option, .size-option {
            border: 2px solid var(--gray);
            border-radius: 4px;
            padding: 8px 12px;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option:hover, .size-option:hover,
        .color-option.selected, .size-option.selected {
            border-color: var(--primary);
            background: var(--light);
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
        }

        .quantity-selector button {
            width: 36px;
            height: 36px;
            background: var(--light);
            border: 1px solid var(--gray);
            font-size: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .quantity-selector button:hover {
            background: var(--primary);
            color: white;
        }

        .quantity-selector input {
            width: 50px;
            height: 36px;
            text-align: center;
            border: 1px solid var(--gray);
            margin: 0 5px;
        }

        .product-detail-actions {
            display: flex;
            gap: 15px;
        }

        .buy-now-btn {
            background: var(--accent);
            flex: 2;
        }

        /* صفحة الشراء */
        .checkout-page {
            display: none;
            padding: 40px 0;
        }

        .checkout-page:target {
            display: block;
            animation: fadeIn 0.5s ease-in-out;
        }

        .checkout-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .checkout-form, .order-summary {
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 25px;
            animation: slideInUp 0.5s ease-in-out;
        }

        .checkout-form-group {
            margin-bottom: 20px;
        }

        .checkout-form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .checkout-form-group input, .checkout-form-group select, .checkout-form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--gray);
            border-radius: 4px;
            transition: var(--transition);
        }

        .checkout-form-group input:focus, .checkout-form-group select:focus, .checkout-form-group textarea:focus {
            border-color: var(--primary);
            outline: none;
        }

        .order-summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .order-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 2px solid #eee;
        }

        .back-to-products {
            display: inline-block;
            margin-bottom: 20px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .back-to-products:hover {
            text-decoration: underline;
            transform: translateX(-5px);
        }

        /* التذييل */
        footer {
            background: var(--dark);
            color: white;
            padding: 50px 0 20px;
            position: relative;
            overflow: hidden;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            position: relative;
            z-index: 2;
        }

        .footer-column h3 {
            font-size: 18px;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 10px;
        }

        .footer-column h3::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 2px;
            background: var(--primary);
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: var(--gray);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: white;
            margin-right: 5px;
        }

        .social-icons {
            display: flex;
            margin-top: 20px;
        }

        .social-icons a {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 35px;
            height: 35px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            margin-left: 10px;
            color: white;
            transition: var(--transition);
        }

        .social-icons a:hover {
            background: var(--primary);
            transform: translateY(-3px);
        }

        .copyright {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            z-index: 2;
        }

        /* تأثيرات إضافية */
        .pulse-animation {
            animation: pulse 2s infinite;
        }

        .bounce-animation {
            animation: bounce 2s infinite;
        }

        .fade-in {
            animation: fadeIn 1s ease-in-out;
        }

        /* شريط التقدم */
        .progress-bar {
            height: 4px;
            background: var(--primary);
            width: 0%;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: width 0.3s ease;
        }

        /* رسالة تأكيد */
        .confirmation-message {
            position: fixed;
            top: 20px;
            right: 20px;
            background: var(--success);
            color: white;
            padding: 15px 20px;
            border-radius: 4px;
            box-shadow: var(--shadow);
            z-index: 1000;
            opacity: 0;
            transform: translateX(100%);
            transition: all 0.3s ease;
        }

        .confirmation-message.show {
            opacity: 1;
            transform: translateX(0);
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .product-detail-content,
            .checkout-container {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .nav-container {
                flex-direction: column;
            }
            
            .search-bar {
                max-width: 100%;
                margin: 15px 0;
                width: 100%;
            }
            
            .categories-list {
                flex-wrap: wrap;
                justify-content: center;
                padding: 5px;
            }
            
            .categories-list li {
                margin: 5px;
                padding: 5px;
            }
            
            .slide-content {
                max-width: 100%;
                text-align: center;
            }
            
            .offers {
                grid-template-columns: 1fr;
            }
            
            .product-detail-actions {
                flex-direction: column;
            }
            
            .menu-toggle {
                display: block;
            }
            
            .nav-icons .nav-icon:not(.menu-toggle) {
                display: none;
            }
        }

        @media (max-width: 576px) {
            .footer-content {
                grid-template-columns: 1fr;
            }
            
            .hero-slider {
                height: 300px;
            }
            
            .slide-content h2 {
                font-size: 24px;
            }
            
            .side-menu {
                width: 100%;
                right: -100%;
            }
        }

        /* إظهار وإخفاء الصفحات */
        .page {
            display: none;
        }
        
        .page:target {
            display: block;
            animation: fadeIn 0.5s ease-in-out;
        }
        
        #main-page {
            display: block;
        }